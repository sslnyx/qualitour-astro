---
import { Image } from "astro:assets";
import { getLocalePrefix, type Locale } from "../../../i18n/config";
import Layout from "../../../layouts/Layout.astro";
import BookingExperience from "../../../components/booking/BookingExperience";
import { productEntryForTransferCard } from "../../../lib/booking/contracts";
import { resolveTransferWebsiteDetails } from "../../../lib/booking/transfer-website-details";
import { localizedLocation } from "../../../lib/transfer-locations";
import { transferProductBySlug, transferProductPages, type TransferProduct } from "../../../lib/transfer-products";
import { transferRouteCover, type TransferCover } from "../../../lib/transfer-covers";
import fleetImage from "../../../assets/images/fleet/charter-package.jpg";

export function getStaticPaths() {
  return [undefined, "zh"].flatMap(lang =>
    transferProductPages.map(product => ({ params: { lang, slug: product.slug } })),
  );
}

const product = transferProductBySlug(Astro.params.slug ?? "");
if (!product) return Astro.rewrite("/404");

const lang: Locale = Astro.params.lang === "zh" ? "zh" : "en";
const localePrefix = getLocalePrefix(lang);
const listHref = `${localePrefix}/private-transfers`;
const t = (zh: string, en: string) => lang === "zh" ? zh : en;
const directionTitle = (start: string, end: string) => t(`${start}至${end}`, `${start} to ${end}`);
const bookingTitle = (start: string, end: string) => `${start} → ${end}`;
const referencePrice = (item: TransferProduct) => {
  const price = Number(item.price);
  return price > 0 && Number.isFinite(price)
    ? new Intl.NumberFormat(lang === "zh" ? "zh-Hant" : "en-CA", {
      style: "currency", currency: item.currency, currencyDisplay: "code",
    }).format(price)
    : undefined;
};
const defaultEntry = product.cardEntries[0];
const sharedDestination = product.cardEntries.length > 1;
const defaultDirection = sharedDestination ? product : defaultEntry ?? product;
const from = localizedLocation(defaultDirection.from, lang);
const to = localizedLocation(defaultDirection.to, lang);
const hasVariants = product.variants.length > 1;
const options = product.variants.map(variant => ({
  productId: variant.productId, seater: variant.seater, referencePrice: referencePrice(variant),
}));
const cheapest = product.variants.filter(variant => referencePrice(variant))
  .reduce<TransferProduct | undefined>((min, variant) => !min || Number(variant.price) < Number(min.price) ? variant : min, undefined);
const fromPrice = cheapest && referencePrice(cheapest);
const vehicle = hasVariants
  ? t("11／14 座車型", "11- or 14-seat vehicle")
  : t(`${product.seater} 座車型`, `${product.seater}-seat vehicle`);
const override = (Astro.locals as { qualitourTransferDetails?: unknown }).qualitourTransferDetails;
const defaults = resolveTransferWebsiteDetails(product.details, null, lang);
const details = resolveTransferWebsiteDetails(product.details, override, lang);
const routeTitle = directionTitle(from, to);
const describeRoute = (start: string, end: string) => hasVariants
  ? t(
    `從${start}前往${end}的單程私人接送，可選 11 座或 14 座車型。`,
    `One-way private transfer from ${start} to ${end}, with a choice of an 11- or 14-seat vehicle.`,
  )
  : t(
    `從${start}前往${end}的單程私人接送，使用 ${product.seater} 座車型。`,
    `One-way private transfer from ${start} to ${end} in a ${product.seater}-seat vehicle.`,
  );
const intro = describeRoute(from, to);
const cardEntries = Object.fromEntries(product.cardEntries.map(entry => {
  const start = localizedLocation(entry.from, lang);
  const end = localizedLocation(entry.to, lang);
  return [entry.key, {
    routeId: entry.routeId, from: start, to: end,
    title: directionTitle(start, end), intro: describeRoute(start, end),
    cover: transferRouteCover(entry.from, entry.to, lang),
  }];
}));
const publicOrigin = Astro.site?.origin ?? Astro.url.origin;
const enUrl = new URL(`${getLocalePrefix("en")}/private-transfers/${product.slug}`, publicOrigin).href;
const zhUrl = new URL(`${getLocalePrefix("zh")}/private-transfers/${product.slug}`, publicOrigin).href;
const alternates = [
  { lang: "en", href: enUrl },
  { lang: "zh-Hant", href: zhUrl },
  { lang: "x-default", href: enUrl },
];
const zones = {
  "Greater Vancouver (Zone 1)": t("溫哥華、列治文", "Vancouver and Richmond"),
  "Greater Vancouver (Zone 2)": t("北溫哥華、西溫哥華、本拿比、新西敏、三角洲", "North Vancouver, West Vancouver, Burnaby, New Westminster and Delta"),
  "Greater Vancouver (Zone 3)": t("三聯市、素里、白石、蘭里", "Tri-Cities, Surrey, White Rock and Langley"),
};
const zone = [product.from, product.to].find(place => Object.hasOwn(zones, place)) as keyof typeof zones | undefined;
const serviceArea = zone ? zones[zone] : sharedDestination ? to : undefined;
const journey = {
  title: bookingTitle(from, to),
  pickup: from,
  intendedDropoff: sharedDestination ? undefined : to,
  seater: product.seater,
  serviceArea,
  entries: Object.fromEntries(Object.entries(cardEntries).map(([key, entry]) => [key, {
    title: bookingTitle(entry.from, entry.to), pickup: entry.from, intendedDropoff: entry.to,
    productEntry: productEntryForTransferCard(product.slug, key),
  }])),
  referencePrice: referencePrice(product),
};
const cover = defaultEntry ? transferRouteCover(defaultEntry.from, defaultEntry.to, lang) : undefined;
const photo = cover?.src ?? details.imageUrl;
const description = details.description !== defaults.description ? details.description : "";
---

<Layout title={`${routeTitle} · ${vehicle} | Qualitour`} description={intro} lang={lang} alternates={alternates}>
  <div class="transfer-detail bg-[#f8f8f7] text-gray-900" data-transfer-detail={product.activityId}
    data-transfer-title={routeTitle} data-transfer-defaults={JSON.stringify(product.details)} data-transfer-lang={lang}
    data-transfer-card-entries={JSON.stringify(cardEntries)} data-transfer-list-href={listHref}
    data-transfer-home-href={localePrefix || "/"}
    data-transfer-variants={hasVariants ? JSON.stringify(product.variants.map(({ seater, activityId, details }) => ({ seater, activityId, details }))) : undefined}>
    <div class="border-b border-gray-200 bg-white">
      <div class="mx-auto max-w-7xl px-4 pb-7 pt-5 sm:px-6 sm:pb-9 sm:pt-7 lg:px-8">
        <a data-transfer-back href={`${listHref}#routes`} class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-gray-600 hover:text-orange-800 hover:underline">
          <span class="material-icons text-lg" aria-hidden="true">arrow_back</span><span data-transfer-back-label>{t("所有接送線路", "All transfer routes")}</span>
        </a>
        <h1 data-transfer-title-text aria-label={routeTitle} class="mt-2 max-w-5xl text-3xl font-bold leading-tight tracking-tight sm:text-4xl lg:text-5xl">
          <span data-transfer-start>{from}</span>{" "}
          <span class="inline-flex max-w-full items-baseline gap-2 align-baseline">
            <span class="material-icons transfer-route-title-arrow text-orange-700" aria-hidden="true">east</span>
            <span data-transfer-end class="min-w-0">{to}</span>
          </span>
        </h1>
        <p class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm font-medium text-gray-600 sm:text-base">
          <span class="inline-flex items-center gap-1.5"><span class="material-icons text-lg text-orange-700" aria-hidden="true">east</span>{t("單程私人接送", "One-way private transfer")}</span>
          <span class="inline-flex items-center gap-1.5"><span class="material-icons text-lg text-orange-700" aria-hidden="true">airport_shuttle</span>{vehicle}</span>
        </p>
        {fromPrice && <p class="mt-3 text-sm text-gray-600">
          {t("每車參考價", "Reference price per vehicle")}{" "}
          <strong class="text-base text-gray-900">{hasVariants ? t(`${fromPrice} 起`, `from ${fromPrice}`) : fromPrice}</strong>
        </p>}
        <a class="transfer-primary-action mt-5 inline-flex min-h-12 items-center rounded-lg px-4 font-semibold min-[1100px]:hidden" href="#booking">
          {t("查看日期與報價", "Check dates & price")}
        </a>
      </div>
    </div>
    <div class="transfer-detail__grid mx-auto max-w-7xl px-4 py-6 sm:px-6 sm:py-8 lg:px-8">
      <article class="min-w-0 self-start overflow-hidden rounded-2xl border border-gray-200 bg-white">
        <div class="relative bg-gray-100" data-transfer-photo-pending={sharedDestination ? "" : undefined}>
          <img data-transfer-photo data-transfer-route-cover={cover ? "" : undefined} hidden={!photo} src={photo || undefined} alt={cover?.alt ?? routeTitle}
            class:list={["w-full bg-gray-100 object-cover", cover ? "aspect-video" : "aspect-[16/8]"]}
            width={cover?.width ?? 800} height={cover?.height ?? 400} referrerpolicy="no-referrer" />
          <div data-transfer-fallback-photo hidden={Boolean(photo)}>
            <Image src={fleetImage} alt="" width={800} height={400} class="aspect-[16/8] w-full bg-gray-100 object-cover" />
          </div>
          <div data-transfer-photo-credit hidden={!cover?.credit} class="absolute bottom-0 right-0 max-w-full bg-black/75 px-2 py-1 text-right text-[10px] text-white">
            <a data-transfer-photo-author href={cover?.credit?.href} class="underline underline-offset-2">{cover?.credit?.name}</a>
            <span data-transfer-photo-license hidden={!cover?.credit?.licenseHref}>
              {" · "}<a href={cover?.credit?.licenseHref} class="underline underline-offset-2">{cover?.credit?.license}</a>{" · "}{t("已裁切", "cropped")}
            </span>
          </div>
        </div>
        <div class="p-5 sm:p-6">
          <h2 class="text-xl font-bold">{t("線路介紹", "About this transfer")}</h2>
          <p data-transfer-intro class="mt-2 leading-relaxed text-gray-700">{intro}</p>
          <dl class="mt-5 grid gap-3 border-y border-gray-200 py-4 text-sm">
            <div class="grid grid-cols-[auto_1fr] gap-3"><dt class="font-semibold text-gray-600">{t("上車", "Pickup")}</dt><dd data-transfer-pickup class="m-0 font-semibold">{from}</dd></div>
            <div class="grid grid-cols-[auto_1fr] gap-3"><dt class="font-semibold text-gray-600">{t("下車", "Drop-off")}</dt><dd data-transfer-dropoff class="m-0 font-semibold">{to}</dd></div>
            {serviceArea && <div class="grid grid-cols-[auto_1fr] gap-3"><dt class="font-semibold text-gray-600">{t("服務範圍", "Service area")}</dt><dd class="m-0 font-semibold">{serviceArea}</dd></div>}
          </dl>
          <p data-transfer-description hidden={!description} class="mt-5 whitespace-pre-line text-sm leading-relaxed text-gray-700">{description}</p>
          <details data-transfer-original-description hidden={Boolean(description) || !defaults.description} class="mt-5 text-sm text-gray-700">
            <summary class="cursor-pointer font-semibold text-gray-900">{t("原產品說明", "Original product description")}</summary>
            <p class="mt-2 leading-relaxed text-gray-600">
              {t(`資料日期 ${product.priceDate}，價格及時段以預訂表單核對為準。`, `Source information dated ${product.priceDate}. Check the booking form for current prices and times.`)}
            </p>
            <p data-transfer-original-text class="mt-2 whitespace-pre-line leading-relaxed" lang="en">{defaults.description}</p>
          </details>
          <div data-transfer-includes hidden={!details.includes.length} class="mt-5">
            <h3 class="font-bold">{t("服務包含", "What's included")}</h3>
            <ul class="mt-2 grid gap-2 text-sm text-gray-700">
              {details.includes.map(item => (
                <li class="flex items-start gap-2"><span class="material-icons text-base text-green-700" aria-hidden="true">check</span>{item}</li>
              ))}
            </ul>
            <template>
              <li class="flex items-start gap-2"><span class="material-icons text-base text-green-700" aria-hidden="true">check</span></li>
            </template>
          </div>
        </div>
      </article>
      <section id="booking" class="min-w-0 scroll-mt-24" aria-labelledby="transfer-booking-heading">
        <h2 id="transfer-booking-heading" class="mb-3 text-2xl font-bold tracking-tight">{t("預訂此線路", "Book this transfer")}</h2>
        <BookingExperience lang={lang} productId={product.productId} variants={options} journey={journey} client:load />
      </section>
    </div>
  </div>
</Layout>

<style>
  .transfer-route-title-arrow { font-size: 0.8em; }
  .transfer-detail__grid { display: grid; gap: 1.5rem; }
  @media (scripting: enabled) {
    [data-transfer-photo-pending] :is([data-transfer-photo], [data-transfer-photo-credit]) { visibility: hidden; }
  }
  @media (min-width: 1100px) {
    .transfer-detail__grid { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.25fr); gap: 2rem; }
  }
</style>

<script>
  import { resolveTransferWebsiteDetails } from "../../../lib/booking/transfer-website-details";
  import type { TransferVehicle } from "../../../lib/zaui/transfer-snapshot";
  import type { TransferCover } from "../../../lib/transfer-covers";

  type CardEntry = {
    routeId: string;
    from: string;
    to: string;
    title: string;
    intro: string;
    cover?: TransferCover;
  };

  function applyCardEntry(root: HTMLElement, lang: "en" | "zh") {
    const parameters = new URLSearchParams(window.location.search);
    const key = parameters.get("card");
    if (!key || !root.dataset.transferCardEntries) return;
    const entries = JSON.parse(root.dataset.transferCardEntries) as Record<string, CardEntry>;
    if (!Object.hasOwn(entries, key)) return;
    const entry = entries[key];
    root.dataset.transferTitle = entry.title;
    root.querySelector("[data-transfer-title-text]")?.setAttribute("aria-label", entry.title);
    for (const [field, text] of [
      ["start", entry.from], ["end", entry.to], ["pickup", entry.from],
      ["dropoff", entry.to], ["intro", entry.intro],
    ]) {
      const target = root.querySelector(`[data-transfer-${field}]`);
      if (target) target.textContent = text;
    }

    const back = root.querySelector<HTMLAnchorElement>("[data-transfer-back]");
    const backLabel = root.querySelector("[data-transfer-back-label]");
    const source = parameters.get("source") === "home" ? root.dataset.transferHomeHref : root.dataset.transferListHref;
    if (back && source) {
      back.href = `${source}?card=${encodeURIComponent(key)}#transfer-${entry.routeId}`;
      if (backLabel) backLabel.textContent = lang === "zh" ? "返回線路卡" : "Back to route";
    }

    const cover = entry.cover;
    const photo = root.querySelector<HTMLImageElement>("[data-transfer-photo]");
    const credit = root.querySelector<HTMLElement>("[data-transfer-photo-credit]");
    if (photo && cover) {
      photo.setAttribute("data-transfer-route-cover", "");
      photo.src = cover.src;
      photo.alt = cover.alt;
      photo.width = cover.width;
      photo.height = cover.height;
      photo.classList.remove("aspect-[16/8]");
      photo.classList.add("aspect-video");
      photo.hidden = false;
      root.querySelector("[data-transfer-fallback-photo]")?.setAttribute("hidden", "");
      if (credit) {
        credit.hidden = !cover.credit;
        const author = credit.querySelector<HTMLAnchorElement>("[data-transfer-photo-author]");
        const license = credit.querySelector<HTMLElement>("[data-transfer-photo-license]");
        const licenseLink = license?.querySelector("a");
        if (author && cover.credit) {
          author.href = cover.credit.href;
          author.textContent = cover.credit.name;
        }
        if (license) license.hidden = !cover.credit?.licenseHref;
        if (licenseLink && cover.credit?.licenseHref) {
          licenseLink.href = cover.credit.licenseHref;
          licenseLink.textContent = cover.credit.license ?? "";
        }
      }
    }
  }

  function applyDetails(root: HTMLElement, snapshot: TransferVehicle["details"], override: unknown, lang: "en" | "zh") {
    const defaults = resolveTransferWebsiteDetails(snapshot, null, lang);
    const details = resolveTransferWebsiteDetails(snapshot, override, lang);

    const description = root.querySelector<HTMLElement>("[data-transfer-description]");
    const originalDescription = root.querySelector<HTMLElement>("[data-transfer-original-description]");
    const originalText = root.querySelector<HTMLElement>("[data-transfer-original-text]");
    const photo = root.querySelector<HTMLImageElement>("[data-transfer-photo]");
    const fallback = root.querySelector<HTMLElement>("[data-transfer-fallback-photo]");
    const includes = root.querySelector<HTMLElement>("[data-transfer-includes]");
    const list = includes?.querySelector("ul");
    const item = includes?.querySelector("template")?.content.firstElementChild;

    const routeTitle = root.dataset.transferTitle ?? "";
    if (originalText) originalText.textContent = defaults.description;
    if (description) {
      description.textContent = details.description !== defaults.description ? details.description : "";
      description.hidden = !description.textContent;
      if (originalDescription) originalDescription.hidden = !description.hidden || !defaults.description;
    }
    if (photo && fallback && !photo.hasAttribute("data-transfer-route-cover")) {
      photo.alt = routeTitle;
      if (details.imageUrl !== photo.getAttribute("src")) {
        if (details.imageUrl) photo.src = details.imageUrl;
        else photo.removeAttribute("src");
      }
      const showPhoto = Boolean(details.imageUrl && (!photo.complete || photo.naturalWidth));
      photo.hidden = !showPhoto;
      fallback.hidden = showPhoto;
    }
    if (includes && list && item) {
      list.replaceChildren(...details.includes.map(label => {
        const entry = item.cloneNode(true) as HTMLLIElement;
        entry.append(label);
        return entry;
      }));
      includes.hidden = details.includes.length === 0;
    }
  }

  function attachDetailUpdates(root: HTMLElement) {
    const language = root.dataset.transferLang;
    const initialActivityId = root.dataset.transferDetail;
    if (!initialActivityId || (language !== "en" && language !== "zh") || !root.dataset.transferDefaults) return;
    const lang: "en" | "zh" = language;
    applyCardEntry(root, lang);
    const initialDetails = JSON.parse(root.dataset.transferDefaults) as TransferVehicle["details"];
    const variants = root.dataset.transferVariants
      ? JSON.parse(root.dataset.transferVariants) as Pick<TransferVehicle, "activityId" | "seater" | "details">[]
      : [];
    let request: AbortController | undefined;

    async function refresh(reset: boolean) {
      request?.abort();
      const current = new AbortController();
      request = current;
      const seat = new URLSearchParams(window.location.search).get("vehicle");
      const variant = variants.find(option => option.seater === seat);
      const activityId = variant?.activityId ?? initialActivityId;
      const snapshot = variant?.details ?? initialDetails;
      if (reset || activityId !== initialActivityId) applyDetails(root, snapshot, null, lang);
      const response = await fetch(`/api/transfer/details/${activityId}`, { credentials: "omit", signal: current.signal });
      if (!response.ok) return;
      const override = await response.json();
      if (!current.signal.aborted) applyDetails(root, snapshot, override, lang);
    }

    const photo = root.querySelector<HTMLImageElement>("[data-transfer-photo]");
    const fallback = root.querySelector<HTMLElement>("[data-transfer-fallback-photo]");
    const pendingPhoto = root.querySelector("[data-transfer-photo-pending]");
    if (photo && fallback) {
      const showFallback = () => {
        photo.hidden = true;
        fallback.hidden = false;
      };
      photo.addEventListener("error", showFallback);
      if (photo.hasAttribute("src") && photo.complete && !photo.naturalWidth) showFallback();
      if (pendingPhoto) {
        // The static page may start with the other entry's photo.
        void photo.decode()
          .catch(showFallback)
          .finally(() => pendingPhoto.removeAttribute("data-transfer-photo-pending"));
      }
    }

    void refresh(false).catch(() => {});
    if (variants.length) {
      window.addEventListener("qualitour:transfer-vehicle-change", () => void refresh(true).catch(() => {}));
    }
  }

  const transferDetail = document.querySelector<HTMLElement>("[data-transfer-detail]");
  if (transferDetail) attachDetailUpdates(transferDetail);
</script>
