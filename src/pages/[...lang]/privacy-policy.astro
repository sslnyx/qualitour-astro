---
import { getLocalePrefix, type Locale } from "../../i18n/config";
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import privacyHeroImg from "../../assets/images/privacy-hero.png";

// Generate paths for both locales
export function getStaticPaths() {
    return [
        { params: { lang: undefined } }, // English: /privacy-policy
        { params: { lang: "zh" } }, // Chinese: /zh/privacy-policy
    ];
}

const { lang } = Astro.params;
const currentLang: Locale = (lang as Locale) || "en";
const localePrefix = getLocalePrefix(currentLang);

// Translations
const t = {
    heroTitle: currentLang === "zh" ? "隱私政策" : "Privacy Policy",
    heroSubtitle:
        currentLang === "zh"
            ? "我們致力於保護您的個人信息，並對其使用方式保持透明。"
            : "We are committed to protecting your personal information and being transparent about how we use it.",
    heroBadge: currentLang === "zh" ? "您的隱私很重要" : "Your Privacy Matters",
    lastUpdated:
        currentLang === "zh"
            ? "最後更新：2024年12月15日"
            : "Last updated: December 15, 2024",
    introText:
        currentLang === "zh"
            ? "本隱私政策描述了Qualitour Travel & Tour Experiences（'我們'或'本公司'）如何在您訪問我們的網站www.qualitour.ca（'本站'）或使用我們的旅遊預訂服務時收集、使用和共享您的個人信息。"
            : 'This Privacy Policy describes how Qualitour Travel & Tour Experiences ("we", "us", or "our") collects, uses, and shares your personal information when you visit our website at www.qualitour.ca (the "Site") or use our tour booking services.',
    deviceInfoTitle: currentLang === "zh" ? "設備信息" : "Device Information",
    deviceInfoIntro:
        currentLang === "zh"
            ? "當您訪問本站時，我們會自動收集有關您設備的某些信息，包括："
            : "When you visit our Site, we automatically collect certain information about your device, including:",
    bookingInfoTitle: currentLang === "zh" ? "預訂信息" : "Booking Information",
    bookingInfoIntro:
        currentLang === "zh"
            ? "當您進行預訂諮詢或購買時，我們會收集："
            : "When you make a booking inquiry or purchase, we collect:",
    sharingIntro:
        currentLang === "zh"
            ? "我們可能會與受信任的第三方共享您的信息，以幫助我們提供和改進服務："
            : "We may share your information with trusted third parties to help us provide and improve our services:",
    noSellNotice:
        currentLang === "zh"
            ? "我們絕不會將您的個人信息出售給第三方用於營銷目的。"
            : "We never sell your personal information to third parties for marketing purposes.",
    rightsIntro:
        currentLang === "zh"
            ? "您對您的個人信息擁有以下權利："
            : "You have the following rights regarding your personal information:",
    gdprTitle:
        currentLang === "zh" ? "歐盟居民（GDPR）" : "For EU Residents (GDPR)",
    gdprText:
        currentLang === "zh"
            ? "如果您是歐洲經濟區的居民，您在GDPR下享有額外權利。請注意，您的信息可能會被轉移到歐洲以外的地區，包括加拿大。"
            : "If you are a resident of the European Economic Area, you have additional rights under GDPR. Please note that your information may be transferred outside of Europe, including to Canada.",
    retentionTitle: currentLang === "zh" ? "數據保留" : "Data Retention",
    retentionText:
        currentLang === "zh"
            ? "除非您請求刪除，否則我們會保留您的預訂信息以供記錄。設備信息通常保留最多2年用於分析目的。"
            : "We retain your booking information for our records unless you request deletion. Device information is typically retained for up to 2 years for analytics purposes.",
    contactIntro:
        currentLang === "zh"
            ? "如有關於我們隱私慣例的問題、行使您的權利或投訴，請聯繫我們："
            : "For questions about our privacy practices, to exercise your rights, or to make a complaint, please contact us:",
    email: currentLang === "zh" ? "電子郵件" : "Email",
    phone: currentLang === "zh" ? "電話" : "Phone",
    mailingAddress: currentLang === "zh" ? "郵寄地址" : "Mailing Address",
    policyUpdateNotice:
        currentLang === "zh"
            ? "我們可能會不時更新本隱私政策。任何更改都將在此頁面發佈，並附有更新的修訂日期。"
            : "We may update this privacy policy from time to time. Any changes will be posted on this page with an updated revision date.",
    ctaTitle:
        currentLang === "zh"
            ? "對隱私有疑問？"
            : "Have Questions About Your Privacy?",
    ctaText:
        currentLang === "zh"
            ? "我們隨時爲您提供幫助。如有任何隱私相關問題，請聯繫我們的團隊。"
            : "We're here to help. Reach out to our team for any privacy-related concerns.",
    contactUs: currentLang === "zh" ? "聯繫我們" : "Contact Us",
};

// Policy sections with Material Icons
const policySections = [
    {
        id: "information-collect",
        icon: "description",
        title:
            currentLang === "zh" ? "我們收集的信息" : "Information We Collect",
    },
    {
        id: "how-we-use",
        icon: "settings",
        title:
            currentLang === "zh"
                ? "我們如何使用您的信息"
                : "How We Use Your Information",
    },
    {
        id: "sharing",
        icon: "share",
        title: currentLang === "zh" ? "信息共享" : "Information Sharing",
    },
    {
        id: "your-rights",
        icon: "verified_user",
        title: currentLang === "zh" ? "您的權利" : "Your Rights",
    },
    {
        id: "contact",
        icon: "mail",
        title: currentLang === "zh" ? "聯繫我們" : "Contact Us",
    },
];

const deviceInfoItems =
    currentLang === "zh"
        ? [
              { label: "瀏覽器信息", desc: "您的網絡瀏覽器類型和版本" },
              { label: "IP地址", desc: "您設備的互聯網協議地址" },
              { label: "Cookies", desc: "放置在您設備上以增強體驗的數據文件" },
              { label: "使用數據", desc: "訪問的頁面、停留時間和交互模式" },
          ]
        : [
              {
                  label: "Browser Information",
                  desc: "Your web browser type and version",
              },
              {
                  label: "IP Address",
                  desc: "Your device's Internet Protocol address",
              },
              {
                  label: "Cookies",
                  desc: "Data files placed on your device to enhance your experience",
              },
              {
                  label: "Usage Data",
                  desc: "Pages visited, time spent, and interaction patterns",
              },
          ];

const bookingInfoItems =
    currentLang === "zh"
        ? [
              { label: "聯繫方式", desc: "姓名、電子郵件地址和電話號碼" },
              { label: "旅行信息", desc: "首選日期、目的地和團隊規模" },
              {
                  label: "支付信息",
                  desc: "賬單詳情（通過第三方提供商安全處理）",
              },
              { label: "特殊要求", desc: "飲食需求、無障礙要求等" },
          ]
        : [
              {
                  label: "Contact Details",
                  desc: "Name, email address, and phone number",
              },
              {
                  label: "Travel Information",
                  desc: "Preferred dates, destinations, and group size",
              },
              {
                  label: "Payment Information",
                  desc: "Billing details (processed securely via third-party providers)",
              },
              {
                  label: "Special Requirements",
                  desc: "Dietary needs, accessibility requirements, etc.",
              },
          ];

const usageItems =
    currentLang === "zh"
        ? [
              {
                  icon: "flight",
                  title: "完成您的預訂",
                  desc: "處理旅遊預訂、安排行程並提供預訂確認。",
              },
              {
                  icon: "chat",
                  title: "與您溝通",
                  desc: "發送預訂更新、回覆諮詢並提供客戶支持。",
              },
              {
                  icon: "trending_up",
                  title: "改進我們的服務",
                  desc: "分析使用模式以增強我們的網站和旅遊產品。",
              },
              {
                  icon: "security",
                  title: "防範欺詐",
                  desc: "篩查交易以識別潛在風險並確保安全運營。",
              },
          ]
        : [
              {
                  icon: "flight",
                  title: "Fulfill Your Bookings",
                  desc: "Process tour reservations, arrange itineraries, and provide booking confirmations.",
              },
              {
                  icon: "chat",
                  title: "Communicate With You",
                  desc: "Send booking updates, respond to inquiries, and provide customer support.",
              },
              {
                  icon: "trending_up",
                  title: "Improve Our Services",
                  desc: "Analyze usage patterns to enhance our website and tour offerings.",
              },
              {
                  icon: "security",
                  title: "Protect Against Fraud",
                  desc: "Screen transactions for potential risk and ensure secure operations.",
              },
          ];

const sharingItems =
    currentLang === "zh"
        ? [
              {
                  icon: "confirmation_number",
                  title: "預訂合作伙伴",
                  desc: "我們與旅行社和預訂平臺合作，以完成您的旅行安排。",
              },
              {
                  icon: "analytics",
                  title: "分析服務",
                  desc: "我們使用Google Analytics來了解訪客如何使用本站。",
              },
              {
                  icon: "gavel",
                  title: "法律要求",
                  desc: "當法律要求或爲保護我們的權利時，我們可能會披露信息。",
              },
          ]
        : [
              {
                  icon: "confirmation_number",
                  title: "Booking Partners",
                  desc: "We work with tour operators and booking platforms to fulfill your travel arrangements.",
              },
              {
                  icon: "analytics",
                  title: "Analytics Services",
                  desc: "We use Google Analytics to understand how visitors use our Site.",
              },
              {
                  icon: "gavel",
                  title: "Legal Requirements",
                  desc: "We may disclose information when required by law or to protect our rights.",
              },
          ];

const rightsItems =
    currentLang === "zh"
        ? [
              {
                  icon: "visibility",
                  title: "訪問權",
                  desc: "請求獲取您的數據副本",
              },
              {
                  icon: "edit",
                  title: "更正權",
                  desc: "更新不準確的信息",
              },
              { icon: "delete", title: "刪除權", desc: "請求刪除數據" },
              {
                  icon: "block",
                  title: "退出權",
                  desc: "取消訂閱營銷信息",
              },
          ]
        : [
              {
                  icon: "visibility",
                  title: "Right to Access",
                  desc: "Request a copy of your data",
              },
              {
                  icon: "edit",
                  title: "Right to Correct",
                  desc: "Update inaccurate information",
              },
              {
                  icon: "delete",
                  title: "Right to Delete",
                  desc: "Request data removal",
              },
              {
                  icon: "block",
                  title: "Right to Opt-Out",
                  desc: "Unsubscribe from marketing",
              },
          ];
---

<Layout
    title={currentLang === "zh"
        ? "隱私政策 | Qualitour"
        : "Privacy Policy | Qualitour"}
    description={currentLang === "zh"
        ? "Qualitour隱私政策 - 瞭解我們如何收集、使用和保護您的個人信息。"
        : "Qualitour Privacy Policy - Learn how we collect, use, and protect your personal information."}
    lang={currentLang}
>
    <!-- Hero Section -->
    <PageHero
        image={privacyHeroImg}
        title={t.heroTitle}
        subtitle={t.heroSubtitle}
        badge={{ icon: "lock", text: t.heroBadge }}
    >
        <p class="text-white/50 text-sm mb-10">
            {t.lastUpdated}
        </p>

        <!-- Quick Jump Links -->
        <div class="flex flex-wrap justify-center gap-3">
            {
                policySections.map((section) => (
                    <a
                        href={`#${section.id}`}
                        class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 backdrop-blur-sm text-white rounded-full text-sm font-medium border border-white/10 hover:bg-white/20 transition-all"
                    >
                        <span class="material-icons text-base">
                            {section.icon}
                        </span>
                        <span>{section.title}</span>
                    </a>
                ))
            }
        </div>
    </PageHero>

    <!-- Policy Content -->
    <section class="py-16 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="policy-copy max-w-3xl mx-auto">
                <!-- Introduction Card -->
                <div class="bg-white rounded-2xl shadow-lg p-8 mb-12">
                    <p class="text-lg text-gray-700 leading-relaxed">
                        {t.introText}
                    </p>
                </div>

                <!-- Section 1: Information We Collect -->
                <div id="information-collect" class="scroll-mt-24 mb-12">
                    <div class="flex items-center gap-4 mb-6">
                        <div
                            class="w-14 h-14 bg-gradient-to-br from-[#f7941e] to-[#ff6b35] rounded-xl flex items-center justify-center shadow-lg shadow-orange-200/50"
                        >
                            <span class="material-icons text-white text-2xl"
                                >description</span
                            >
                        </div>
                        <h2
                            class="text-2xl md:text-3xl font-bold text-gray-900"
                        >
                            {policySections[0].title}
                        </h2>
                    </div>
                    <div class="bg-white rounded-2xl shadow-lg p-8">
                        <h3 class="text-xl font-semibold text-gray-900 mb-4">
                            {t.deviceInfoTitle}
                        </h3>
                        <p class="text-gray-600 mb-4">
                            {t.deviceInfoIntro}
                        </p>
                        <ul class="space-y-3 mb-8">
                            {
                                deviceInfoItems.map((item) => (
                                    <li class="flex items-start gap-3">
                                        <span class="material-icons text-[#f7941e] text-lg mt-0.5">
                                            check_circle
                                        </span>
                                        <span class="text-gray-700">
                                            <strong class="text-gray-900">
                                                {item.label}:
                                            </strong>{" "}
                                            {item.desc}
                                        </span>
                                    </li>
                                ))
                            }
                        </ul>

                        <h3 class="text-xl font-semibold text-gray-900 mb-4">
                            {t.bookingInfoTitle}
                        </h3>
                        <p class="text-gray-600 mb-4">
                            {t.bookingInfoIntro}
                        </p>
                        <ul class="space-y-3">
                            {
                                bookingInfoItems.map((item) => (
                                    <li class="flex items-start gap-3">
                                        <span class="material-icons text-[#f7941e] text-lg mt-0.5">
                                            check_circle
                                        </span>
                                        <span class="text-gray-700">
                                            <strong class="text-gray-900">
                                                {item.label}:
                                            </strong>{" "}
                                            {item.desc}
                                        </span>
                                    </li>
                                ))
                            }
                        </ul>
                    </div>
                </div>

                <!-- Section 2: How We Use Your Information -->
                <div id="how-we-use" class="scroll-mt-24 mb-12">
                    <div class="flex items-center gap-4 mb-6">
                        <div
                            class="w-14 h-14 bg-gradient-to-br from-[#f7941e] to-[#ff6b35] rounded-xl flex items-center justify-center shadow-lg shadow-orange-200/50"
                        >
                            <span class="material-icons text-white text-2xl"
                                >settings</span
                            >
                        </div>
                        <h2
                            class="text-2xl md:text-3xl font-bold text-gray-900"
                        >
                            {policySections[1].title}
                        </h2>
                    </div>
                    <div class="bg-white rounded-2xl shadow-lg p-8">
                        <div class="grid md:grid-cols-2 gap-6">
                            {
                                usageItems.map((item) => (
                                    <div class="flex items-start gap-4 p-4 bg-gray-50 rounded-xl">
                                        <div class="w-12 h-12 bg-white rounded-lg flex items-center justify-center shadow-sm flex-shrink-0">
                                            <span class="material-icons text-[#f7941e] text-xl">
                                                {item.icon}
                                            </span>
                                        </div>
                                        <div>
                                            <h3 class="font-semibold text-gray-900 mb-1">
                                                {item.title}
                                            </h3>
                                            <p class="text-gray-600 text-sm">
                                                {item.desc}
                                            </p>
                                        </div>
                                    </div>
                                ))
                            }
                        </div>
                    </div>
                </div>

                <!-- Section 3: Information Sharing -->
                <div id="sharing" class="scroll-mt-24 mb-12">
                    <div class="flex items-center gap-4 mb-6">
                        <div
                            class="w-14 h-14 bg-gradient-to-br from-[#f7941e] to-[#ff6b35] rounded-xl flex items-center justify-center shadow-lg shadow-orange-200/50"
                        >
                            <span class="material-icons text-white text-2xl"
                                >share</span
                            >
                        </div>
                        <h2
                            class="text-2xl md:text-3xl font-bold text-gray-900"
                        >
                            {policySections[2].title}
                        </h2>
                    </div>
                    <div class="bg-white rounded-2xl shadow-lg p-8">
                        <p class="text-gray-600 mb-6">
                            {t.sharingIntro}
                        </p>

                        <div class="space-y-4">
                            {
                                sharingItems.map((item) => (
                                    <div class="flex items-start gap-4 p-4 border border-gray-200 rounded-xl hover:border-[#f7941e]/30 transition-colors">
                                        <div class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center flex-shrink-0">
                                            <span class="material-icons text-gray-600">
                                                {item.icon}
                                            </span>
                                        </div>
                                        <div>
                                            <h4 class="font-semibold text-gray-900">
                                                {item.title}
                                            </h4>
                                            <p class="text-gray-600 text-sm">
                                                {item.desc}
                                            </p>
                                        </div>
                                    </div>
                                ))
                            }
                        </div>

                        <div
                            class="mt-6 p-4 bg-gray-50 rounded-xl border border-gray-200 flex items-start gap-3"
                        >
                            <span class="material-icons text-gray-600"
                                >info</span
                            >
                            <p class="text-gray-600 text-sm">
                                {t.noSellNotice}
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Section 4: Your Rights -->
                <div id="your-rights" class="scroll-mt-24 mb-12">
                    <div class="flex items-center gap-4 mb-6">
                        <div
                            class="w-14 h-14 bg-gradient-to-br from-[#f7941e] to-[#ff6b35] rounded-xl flex items-center justify-center shadow-lg shadow-orange-200/50"
                        >
                            <span class="material-icons text-white text-2xl"
                                >verified_user</span
                            >
                        </div>
                        <h2
                            class="text-2xl md:text-3xl font-bold text-gray-900"
                        >
                            {policySections[3].title}
                        </h2>
                    </div>
                    <div class="bg-white rounded-2xl shadow-lg p-8">
                        <p class="text-gray-600 mb-6">
                            {t.rightsIntro}
                        </p>

                        <div class="grid sm:grid-cols-2 gap-4 mb-6">
                            {
                                rightsItems.map((item) => (
                                    <div class="flex items-center gap-3 p-4 border border-gray-200 rounded-xl">
                                        <span class="material-icons text-[#f7941e]">
                                            {item.icon}
                                        </span>
                                        <div>
                                            <span class="font-semibold text-gray-900 block">
                                                {item.title}
                                            </span>
                                            <span class="text-sm text-gray-500">
                                                {item.desc}
                                            </span>
                                        </div>
                                    </div>
                                ))
                            }
                        </div>

                        <div
                            class="p-4 bg-gray-50 rounded-xl border border-gray-200 mb-6"
                        >
                            <h4
                                class="font-semibold text-gray-900 mb-2 flex items-center gap-2"
                            >
                                <span
                                    class="material-icons text-gray-600 text-lg"
                                    >public</span
                                >
                                For EU Residents (GDPR)
                            </h4>
                            <p class="text-gray-600 text-sm">
                                {t.gdprText}
                            </p>
                        </div>

                        <div
                            class="p-4 bg-gray-50 rounded-xl border border-gray-200"
                        >
                            <h4
                                class="font-semibold text-gray-900 mb-2 flex items-center gap-2"
                            >
                                <span
                                    class="material-icons text-gray-600 text-lg"
                                    >schedule</span
                                >
                                {t.retentionTitle}
                            </h4>
                            <p class="text-gray-600 text-sm">
                                {t.retentionText}
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Section 5: Contact Us -->
                <div id="contact" class="scroll-mt-24 mb-12">
                    <div class="flex items-center gap-4 mb-6">
                        <div
                            class="w-14 h-14 bg-gradient-to-br from-[#f7941e] to-[#ff6b35] rounded-xl flex items-center justify-center shadow-lg shadow-orange-200/50"
                        >
                            <span class="material-icons text-white text-2xl"
                                >mail</span
                            >
                        </div>
                        <h2
                            class="text-2xl md:text-3xl font-bold text-gray-900"
                        >
                            {policySections[4].title}
                        </h2>
                    </div>
                    <div class="bg-white rounded-2xl shadow-lg p-8">
                        <p class="text-gray-600 mb-6">
                            {t.contactIntro}
                        </p>

                        <div class="grid md:grid-cols-2 gap-6 mb-6">
                            <a
                                href="mailto:info@qualitour.ca"
                                class="flex items-center gap-4 p-4 border border-gray-200 rounded-xl hover:border-[#f7941e] hover:bg-orange-50/50 transition-all group"
                            >
                                <div
                                    class="w-12 h-12 bg-gray-100 group-hover:bg-[#f7941e] rounded-xl flex items-center justify-center transition-colors"
                                >
                                    <span
                                        class="material-icons text-gray-600 group-hover:text-white transition-colors"
                                        >email</span
                                    >
                                </div>
                                <div>
                                    <span
                                        class="font-semibold text-gray-900 block"
                                        >{t.email}</span
                                    >
                                    <span class="text-[#f7941e]"
                                        >info@qualitour.ca</span
                                    >
                                </div>
                            </a>

                            <a
                                href="tel:+17789456000"
                                class="flex items-center gap-4 p-4 border border-gray-200 rounded-xl hover:border-[#f7941e] hover:bg-orange-50/50 transition-all group"
                            >
                                <div
                                    class="w-12 h-12 bg-gray-100 group-hover:bg-[#f7941e] rounded-xl flex items-center justify-center transition-colors"
                                >
                                    <span
                                        class="material-icons text-gray-600 group-hover:text-white transition-colors"
                                        >phone</span
                                    >
                                </div>
                                <div>
                                    <span
                                        class="font-semibold text-gray-900 block"
                                        >{t.phone}</span
                                    >
                                    <span class="text-[#f7941e]"
                                        >(778) 945-6000</span
                                    >
                                </div>
                            </a>
                        </div>

                        <div
                            class="p-6 bg-gray-50 rounded-xl border border-gray-200"
                        >
                            <h4
