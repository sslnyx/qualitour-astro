---
import type { Locale } from "../../i18n/config";
import Layout from "../../layouts/Layout.astro";
import BookingExperience from "../../components/booking/BookingExperience";

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: "zh" } },
  ];
}

const { lang } = Astro.params;
const currentLang: Locale = (lang as Locale) || "en";
---

<Layout
  title={currentLang === "zh" ? "私人接送 Sandbox 預訂 | Qualitour" : "Private Transfer Sandbox Booking | Qualitour"}
  description={currentLang === "zh"
    ? "使用 Qualitour Sandbox 測試私人接送報價、預訂及 Stripe 測試付款。"
    : "Test a Qualitour private-transfer quote, reservation and Stripe Sandbox payment."}
  lang={currentLang}
>
  <div class="native-booking-page">
    <BookingExperience lang={currentLang} client:load />
  </div>
</Layout>

<style>
  .native-booking-page { min-height: 70vh; padding: 28px 0 64px; background: #f8fafc; }
</style>
