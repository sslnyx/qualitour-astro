---
import { type Locale } from '../../../../i18n/config';
import TourCategoryPage from '../../../../components/TourCategoryPage.astro';
import { getAllTours, getSiteNavData } from '../../../../lib/wordpress/api';
import { optimizeTourImages } from '../../../../lib/wordpress/image';

// Category pages exist only in the CMS runtime, where the route is rendered per
// request from the live catalogue; static and WordPress builds emit none.
export function getStaticPaths() {
  return [];
}

const { lang: langParam } = Astro.params;
const lang: Locale = langParam === 'zh' ? 'zh' : 'en';
const { destination: term, alternates = [] } = (Astro.locals as { qualitourPageProps?: Record<string, any> }).qualitourPageProps || {};
if (!term) return new Response(null, { status: 404 });

const [allTours, navData] = await Promise.all([getAllTours(lang), getSiteNavData(lang)]);
const members = allTours.filter((tour) => (tour.tour_terms?.destinationScope || []).includes(term.slug));
const tours = await optimizeTourImages(members, { concurrency: 20 });
---

<TourCategoryPage kind="destination" term={term} tours={tours} destinations={navData.destinations} cruiseTypes={navData.cruiseTypes} regionTerms={navData.regions} alternates={alternates} lang={lang} />
