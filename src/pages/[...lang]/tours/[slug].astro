---
import { getLocalePrefix, type Locale } from '../../../i18n/config';
import Layout from '../../../layouts/Layout.astro';
import TourPage from '../../../components/TourPage.astro';
import { getGoogleReviews } from '../../../lib/wordpress/api';
import { getTourBuildData } from '../../../lib/wordpress/tour-build-data';
import { tourMetadata } from '../../../lib/seo';
import { confirmedTourAlternates, tourStructuredData, type Alternate } from '../../../lib/seo-pages';
import type { WPTour, GoogleReview } from '../../../lib/wordpress/types';
import { optimizeTourPresentation, optimizeTourPresentations } from '../../../lib/wordpress/image';

export const prerender = true;

export async function getStaticPaths() {
  const en = await getTourBuildData('en');
  const zh = await getTourBuildData('zh');
  const presented = await optimizeTourPresentations([...en, ...zh]);
  const languages = { en: presented.slice(0, en.length), zh: presented.slice(en.length) };
  // Fetch once per build; keep optional reviews separate from essential tour content.
  const reviews = await getGoogleReviews();
  return (['en', 'zh'] as const).flatMap(lang => languages[lang].map(tour => {
    const alternates = confirmedTourAlternates(tour, lang, languages, import.meta.env.SITE || 'https://qualitour.ca', import.meta.env.BASE_URL);
    const reviewTourId = lang === 'en' ? tour.id : alternates.length ? tour.translations?.en?.id : undefined;
    return ({
    params: { lang: lang === 'en' ? undefined : lang, slug: decodeURIComponent(tour.slug) },
    props: {
      tour,
      reviews: reviews.filter(review => {
        const ids = review.related_tours;
        return reviewTourId !== undefined && (Array.isArray(ids) ? ids.includes(reviewTourId) : ids === reviewTourId);
      }).slice(0, 6),
      alternates,
      duplicateTitle: languages[lang].filter(other => other.title.rendered === tour.title.rendered).length > 1,
    },
  }); }));
}

interface Props { tour: WPTour; reviews: GoogleReview[]; alternates: Alternate[]; duplicateTitle: boolean }
const { tour, reviews, alternates, duplicateTitle } = Astro.props;
const lang: Locale = Astro.params.lang === 'zh' ? 'zh' : 'en';
const localePrefix = getLocalePrefix(lang);
const metadata = tourMetadata(tour);
const displayTour = tour.optimizedPhotos ? tour : await optimizeTourPresentation(tour);
const price = tour.tour_meta?.['tour-price-text'] || tour.tour_meta?.price;
const currency = tour.tour_meta?.['tourmaster-tour-currency'];
if (duplicateTitle && price && currency) metadata.title = metadata.title.replace(' | Qualitour', ` (${price} ${currency}) | Qualitour`);
const origin = Astro.site?.origin || 'https://qualitour.ca';
const base = import.meta.env.BASE_URL;
const safeTranslations: { en?: { id: number; slug: string }; zh?: { id: number; slug: string } } = {};
if (alternates.length) {
  safeTranslations[lang] = { id: tour.id, slug: decodeURIComponent(tour.slug) };
  const other = lang === 'en' ? 'zh' : 'en';
  const translation = tour.translations?.[other];
  if (translation) safeTranslations[other] = { id: translation.id, slug: decodeURIComponent(translation.slug) };
}
---

<Layout {...metadata} heroImage={displayTour.optimizedHero?.src} heroImageSrcSet={displayTour.optimizedHero?.srcSet}
  heroImageSizes={displayTour.optimizedHero?.sizes} lang={lang} tourTranslations={safeTranslations}
  alternates={alternates} structuredData={tourStructuredData(tour, origin, base, lang)}>
  <TourPage tour={displayTour} lang={lang} localePrefix={localePrefix} reviews={reviews} />
</Layout>
