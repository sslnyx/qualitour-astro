---
import { getLocalePrefix, type Locale } from "../../../i18n/config";
import Layout from "../../../layouts/Layout.astro";
import { getImage } from "astro:assets";
import { getAllTours, getSiteNavData } from "../../../lib/wordpress/api";
import type { WPTour, WPTourFeaturedImage } from "../../../lib/wordpress/types";
import { toTourBrowseCard } from "../../../lib/tour-browse.mjs";
import { ToursGrid } from "../../../components/ToursGrid";
import { TourFilterSidebarClient } from "../../../components/TourFilterSidebarClient";
import { TourDestinationChips } from "../../../components/TourDestinationChips";
import { wpUrl } from "../../../lib/wp-url";

// Generate paths for both locales
export function getStaticPaths() {
  return [
    { params: { lang: undefined } }, // English: /tours
    { params: { lang: "zh" } }, // Chinese: /zh/tours
  ];
}

const { lang: langParam } = Astro.params;
const lang: Locale = (langParam as Locale) || "en";
const localePrefix = getLocalePrefix(lang as Locale);

import { optimizeTourImages } from "../../../lib/wordpress/image";

// Fetch all tours and filter data at build time
const [rawTours, navData] = await Promise.all([
  getAllTours(lang),
  getSiteNavData(lang),
]);
// Countries (level 2) with the most tours; every link is a real category page.
const featuredDestinations = navData.destinations
  .filter((dest) => dest.level === 2)
  .sort((a, b) => b.count - a.count)
  .slice(0, 12);

// Pre-optimize tour images at build time with concurrency limit
const tours = await optimizeTourImages(rawTours, { concurrency: 20 });
---

<Layout
  title={lang === "zh" ? "所有行程 | Qualitour" : "All Tours | Qualitour"}
  description={lang === "zh"
    ? "探索我們精心策劃的高端旅遊行程。從文化冒險到自然奇觀，尋找您的完美旅程。"
    : "Explore our curated collection of premium tours. From cultural adventures to scenic wonders, find your perfect journey."}
  lang={lang}
>
  <div class="min-h-screen bg-gray-50">
    {/* Compact page header: title plus quick destination filter, so tours start above the fold */}
    <section class="bg-white border-b border-gray-200 pt-5 pb-4 md:pt-7 md:pb-6">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between lg:gap-8">
          <div class="min-w-0">
            <nav class="text-sm mb-1.5" aria-label="Breadcrumb">
              <a
                href={`${localePrefix}/`}
                class="text-gray-500 hover:text-gray-900 transition-colors"
                >{lang === "zh" ? "首頁" : "Home"}</a
              >
              <span class="mx-2 text-gray-300">/</span>
              <span class="text-[#f7941e]"
                >{lang === "zh" ? "行程" : "Tours"}</span
              >
            </nav>
            <h1 class="text-2xl md:text-3xl font-bold text-gray-900 leading-tight">
              {lang === "zh" ? "探索我們的行程" : "Explore Our Tours"}
            </h1>
            <p class="mt-1 text-sm md:text-base text-gray-500">
              {
                lang === "zh"
                  ? "在我們最精彩的目的地中發現難忘的旅程"
                  : "Discover unforgettable journeys through our most remarkable destinations"
              }
            </p>
          </div>
          <TourDestinationChips
            client:load
            destinations={navData.destinations}
            lang={lang}
          />
        </div>
      </div>
    </section>

    {/* Tours Content with Sidebar */}
    <section class="py-6 md:py-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col lg:flex-row gap-8">
          {/* Filter Sidebar - Component handles desktop sidebar & mobile drawer */}
          <TourFilterSidebarClient
            client:load
            destinations={navData.destinations}
            styles={navData.styles}
            lang={lang}
          />

          {/* Main Content - React Client Component */}
          <ToursGrid
            client:load
            tours={tours.map(toTourBrowseCard)}
            lang={lang}
          />
        </div>
      </div>
    </section>

    {/* Explore by Destination */}
    <section class="py-16 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <span
            class="section-label font-medium uppercase text-orange-500"
          >
            {lang === "zh" ? "瀏覽行程" : "Browse Tours"}
          </span>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mt-2">
            {lang === "zh" ? "按目的地探索" : "Explore by Destination"}
          </h2>
        </div>

        <div
          class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4"
        >
          {
            featuredDestinations.map((dest) => (
              <a
                href={`${localePrefix}/tours/destination/${dest.slug}`}
                class="group p-4 bg-gray-50 rounded-xl hover:bg-orange-50 border border-gray-100 hover:border-orange-200 transition-all text-center"
              >
                <span class="material-icons text-2xl text-gray-400 group-hover:text-orange-500 mb-2 block">
                  location_on
                </span>
                <h3 class="font-medium text-gray-900 group-hover:text-orange-600 transition-colors">
                  {dest.name}
                </h3>
                <p class="text-sm text-gray-500 mt-1">
                  {dest.count} {lang === "zh" ? "個行程" : "tours"}
                </p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    {/* CTA Section */}
    <section class="py-16 bg-gradient-to-r from-orange-500 to-amber-500">
      <div
        class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-white"
      >
        <h2 class="text-3xl md:text-4xl font-bold mb-4">
          {
            lang === "zh"
              ? "找不到您想要的行程？"
              : "Can't Find What You're Looking For?"
          }
        </h2>
        <p class="text-xl opacity-90 mb-8">
          {
            lang === "zh"
              ? "讓我們為您量身定制專屬行程"
              : "Let us create a custom tour tailored to your preferences"
          }
        </p>
        <a
          href={`${localePrefix}/contact`}
          class="inline-flex items-center gap-2 px-8 py-4 bg-white text-orange-500 font-bold rounded-full hover:shadow-xl hover:scale-105 transition-all"
        >
          <span class="material-icons">mail</span>
          {lang === "zh" ? "聯絡我們" : "Contact Us"}
        </a>
      </div>
    </section>
  </div>
</Layout>

<script>
  // Handle destination links to dispatch urlchange event
  document.querySelectorAll('a[href*="?destination="]').forEach((link) => {
    link.addEventListener("click", (e) => {
      e.preventDefault();
      const href = (e.currentTarget as HTMLAnchorElement).getAttribute("href");
      if (href) {
        window.history.pushState({}, "", href);
        window.dispatchEvent(new Event("urlchange"));
        // Scroll to tours section
        document
          .querySelector(".py-12.md\\:py-16")
          ?.scrollIntoView({ behavior: "smooth" });
      }
    });
  });
</script>
