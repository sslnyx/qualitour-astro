---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Server Error | Qualitour" description="Please try again or contact Qualitour for assistance." noindex={true}>
  <section class="min-h-[60vh] flex items-center justify-center px-4 bg-gray-50 text-gray-900">
    <div class="max-w-lg text-center">
      <h1 class="text-3xl font-bold mb-4">Something went wrong</h1>
      <p>Please try again later or contact us for assistance.</p>
      <a class="inline-block mt-6 text-orange-600 underline" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/contact`}>Contact Qualitour</a>
    </div>
  </section>
</Layout>
