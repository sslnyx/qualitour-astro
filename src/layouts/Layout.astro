---
import "../styles/global.css";
import { getCurrentLocale, type Locale } from "../i18n/config";
import SiteNavAstro from "../components/SiteNavAstro.astro";
import { getSiteNavData, type SiteNavData } from "../lib/wordpress/api";
import { sanitizeUrls } from "../lib/wp-url";
import Footer from "../components/Footer.astro";
import SeoHead from "../components/SeoHead.astro";
import type { Alternate } from '../lib/seo-pages';

interface TourTranslation {
  id: number | string;
  slug: string;
}

interface Props {
  title?: string;
  description?: string;
  image?: string;
  heroImage?: string; // LCP image to preload
  heroImageSrcSet?: string;
  heroImageSizes?: string;
  type?: "website" | "article" | "profile";
  lang?: Locale;
  canonical?: string;
  noindex?: boolean;
  alternates?: Alternate[];
  structuredData?: Record<string, unknown>[];
  tourTranslations?: {
    en?: TourTranslation;
    zh?: TourTranslation;
  };
}

const {
  title = "Qualitour | Vancouver Tour Operator & Global Visa Services",
  description = "Qualitour offers premium Canadian tours, private transfers in Vancouver, and expert global visa services. Experience authentic journeys with our professional team.",
  image,
  heroImage,
  heroImageSrcSet,
  heroImageSizes,
  type = "website",
  lang,
  canonical,
  noindex,
  alternates,
  structuredData,
  tourTranslations,
} = Astro.props;

// Get current locale from URL or use provided lang
const currentLocale = lang || getCurrentLocale(Astro.url);
const htmlLang = currentLocale === "zh" ? "zh" : "en-CA";

// Fetch navigation data at build time
let navData: SiteNavData = {
  styles: [],
  cruiseTypes: [],
  regions: [],
  destinations: [],
  transfers: [],
};

try {
  navData = sanitizeUrls(await getSiteNavData(currentLocale));
} catch (e) {
  console.error("Failed to fetch nav data:", e);
}
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <SeoHead
      title={title}
      description={description}
      image={image}
      heroImage={heroImage}
      heroImageSrcSet={heroImageSrcSet}
      heroImageSizes={heroImageSizes}
      type={type}
      canonical={canonical}
      noindex={noindex}
      lang={currentLocale}
      alternates={alternates}
      structuredData={structuredData}
    />
    <script is:inline>
      // Global broken image fallback (Capture phase to catch all img errors)
      document.addEventListener(
        "error",
        function (e) {
          if (e.target.tagName && e.target.tagName.toUpperCase() === "IMG") {
            // Skip images that have debugging enabled
            if (e.target.dataset.originalSrc) {
              console.warn("Image failed to load:", e.target.src);
              return;
            }
            const fallbackUrl =
              "https://images.unsplash.com/photo-1488646953014-85cb44e25828?w=600&h=400&fit=crop&q=80";
            if (
              e.target.src !== fallbackUrl &&
              !e.target.dataset.fallbackTried
            ) {
              e.target.dataset.fallbackTried = "true";
              e.target.src = fallbackUrl;
              e.target.style.objectFit = "cover";
            }
          }
        },
        true,
      );
    </script>
  </head>
  <body
    class="min-h-screen flex flex-col bg-gray-900 text-gray-100 antialiased"
  >
    <a class="skip-to-content" href="#main-content">
      {currentLocale === "zh" ? "跳至主要內容" : "Skip to main content"}
    </a>
    <!-- Navigation (Pure Astro - no React runtime needed) -->
    <SiteNavAstro
      lang={currentLocale}
      destinations={navData.destinations}
      styles={navData.styles}
      cruiseTypes={navData.cruiseTypes}
      alternates={alternates}
      tourTranslations={tourTranslations}
    />

    <!-- Main Content -->
    <main id="main-content" class="flex-1 scroll-mt-20" tabindex="-1">
      <slot />
    </main>

    <!-- Footer -->
    <Footer lang={currentLocale} />
  </body>
</html>

<style is:global>
  :root {
    --font-inter: "Inter", system-ui, sans-serif;
  }
  body {
    font-family: var(--font-inter);
  }
  .skip-to-content {
    position: fixed;
    top: 0.75rem;
    left: 1rem;
    z-index: 100;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    background: white;
    color: #111827;
    transform: translateY(calc(-100% - 1rem));
  }
  .skip-to-content:focus {
    transform: none;
  }
</style>
