---
import { wpUrl } from "../lib/wp-url";
import { absolutePublicUrl, normalizePublicPath, serializeJsonLd } from '../lib/seo';
import { pageAlternates, type Alternate } from '../lib/seo-pages';

// All fonts loaded from CDN with async loading for better performance
// - Inter: Google Fonts CDN
// - Material Icons: Google Fonts CDN
// - Kaushan Script: Removed - using SVG image (~35KB saved)
// - Font Awesome: Removed - using inline SVGs (~99KB saved)

export interface Props {
    title?: string;
    description?: string;
    image?: string;
    type?: "website" | "article" | "profile";
    canonical?: string;
    noindex?: boolean;
    heroImage?: string; // LCP image to preload
    lang?: 'en' | 'zh';
    alternates?: Alternate[];
    structuredData?: Record<string, unknown>[];
}

const {
    title = "Qualitour - Premium China Tours",
    description = "Experience unforgettable journeys through China with our expertly crafted tours.",
    image = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/qualitour_logo.png`,
    type = "website",
    canonical,
    noindex = false,
    heroImage,
    lang = 'en',
    alternates,
    structuredData = [],
} = Astro.props;

const siteUrl =
    Astro.site?.toString() || "https://qualitour.ca";
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
let canonicalUrl = absolutePublicUrl(siteUrl, canonical || Astro.url.pathname);
if (base && normalizePublicPath(Astro.url.pathname) === base) canonicalUrl += '/';
const indexable = import.meta.env.PUBLIC_SITE_INDEXABLE === 'true' && !noindex;
const languageAlternates = alternates ?? pageAlternates(Astro.url.pathname, siteUrl, base || '/');
const schemas = [
    { '@context': 'https://schema.org', '@type': 'Organization', '@id': new URL('/#organization', siteUrl).href, name: 'Qualitour Holiday Inc.', url: new URL('/', siteUrl).href },
    { '@context': 'https://schema.org', '@type': 'WebSite', '@id': new URL(`${base || ''}/#website`, siteUrl).href, url: new URL(`${base || ''}/`, siteUrl).href, name: 'Qualitour', inLanguage: lang, publisher: { '@id': new URL('/#organization', siteUrl).href } },
    ...structuredData,
];
const imageUrl = image?.startsWith("http")
    ? image
    : new URL(image, siteUrl).toString();
---

<!-- Global Metadata -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<!-- Favicons -->
<link rel="icon" type="image/png" sizes="180x180" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.png?v=3`} />
<link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.png?v=3`} />
<!-- Fallback for standard favicon -->
<link rel="shortcut icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.png?v=3`} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

<meta name="robots" content={indexable ? 'index, follow' : 'noindex, follow'} />
{languageAlternates.map(alternate => <link rel="alternate" hreflang={alternate.lang} href={alternate.href} />)}
{schemas.map(schema => <script type="application/ld+json" set:html={serializeJsonLd(schema)} />)}

<!-- Preload LCP Hero Image (responsive: desktop vs mobile) -->
{
    heroImage && (
        <>
            <link
                rel="preload"
                as="image"
                href={heroImage}
                media="(min-width: 769px)"
                fetchpriority="high"
            />
            <link
                rel="preload"
                as="image"
                href={heroImage}
                media="(max-width: 768px)"
                fetchpriority="high"
            />
        </>
    )
}

<!-- Preconnect to Google Fonts (2 origins max) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

<!-- Inter + Material Icons - Combined async loading from Google Fonts CDN -->
<link
    rel="preload"
    as="style"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Material+Icons&display=swap"
    onload="this.onload=null;this.rel='stylesheet'"
/>
<noscript>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Material+Icons&display=swap"
        rel="stylesheet"
    />
</noscript>

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalUrl} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={imageUrl} />
