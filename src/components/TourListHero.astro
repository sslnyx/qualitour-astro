---
import CdnImage from "./CdnImage.astro";
import heroImage from "../assets/tours-hero.webp";

/**
 * TourListHero - image hero for tour category pages
 * (style / destination / featured), at the shared .page-hero height.
 *
 * Shows a photo with a dark overlay, breadcrumb, optional badge, title and
 * subtitle over one shared, generated landscape (src/assets/tours-hero.webp), so the
 * hero never repeats the first tour card's photo.
 */

interface Crumb {
    label: string;
    href?: string;
}

interface Props {
    title: string;
    subtitle?: string;
    crumbs?: Crumb[];
    badge?: { icon: string; text: string };
}

const { title, subtitle, crumbs = [], badge } = Astro.props;
---

<section
    class="page-hero relative flex items-center overflow-hidden bg-gray-900"
>
    <div class="absolute inset-0">
        <CdnImage
            src={heroImage}
            alt=""
            width={1920}
            height={720}
            class="h-full w-full object-cover object-[50%_58%]"
            loading="eager"
            decoding="async"
            quality={75}
            format="webp"
            aria-hidden="true"
        />
    </div>
    <div
        class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/50 to-black/70"
    >
    </div>

    <div
        class="relative z-10 mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8"
    >
        <div class="mx-auto max-w-4xl text-center text-white">
            {
                crumbs.length > 0 && (
                    <nav
                        class="mb-3 flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-sm"
                        aria-label="Breadcrumb"
                    >
                        {crumbs.map((crumb, i) => (
                            <>
                                {i > 0 && <span class="text-white/40">/</span>}
                                {crumb.href ? (
                                    <a
                                        href={crumb.href}
                                        class="text-white/70 transition-colors hover:text-white"
                                    >
                                        {crumb.label}
                                    </a>
                                ) : (
                                    <span class="text-[#f7941e]">
                                        {crumb.label}
                                    </span>
                                )}
                            </>
                        ))}
                    </nav>
                )
            }
            {
                badge && (
                    <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1.5 backdrop-blur-md">
                        <span class="material-icons text-lg text-[#f7941e]">
                            {badge.icon}
                        </span>
                        <span class="text-sm text-white/90">{badge.text}</span>
                    </div>
                )
            }
            <h1
                class="text-4xl font-bold leading-tight drop-shadow-lg md:text-5xl lg:text-6xl"
            >
                {title}
            </h1>
            {
                subtitle && (
                    <p class="mx-auto mt-4 max-w-2xl text-lg text-white/90 md:text-xl">
                        {subtitle}
                    </p>
                )
            }
        </div>
    </div>
</section>
