---
interface Props {
    title: string;
    subtitle?: string;
    align?: "left" | "center";
}

const { title, subtitle, align = "center" } = Astro.props;
---

<header class="page-title bg-gradient-to-r from-gray-900 to-gray-800 text-white">
    <div class:list={[
        "mx-auto max-w-7xl px-4 py-6 sm:px-6 sm:py-10 lg:px-8 lg:py-12",
        align === "center" && "text-center",
    ]}>
        <slot name="breadcrumb" />
        <h1 class="break-words text-3xl font-bold leading-tight sm:text-4xl lg:text-5xl">
            {title}
        </h1>
        {subtitle && (
            <p class:list={[
                "mt-3 max-w-2xl text-base leading-relaxed text-gray-300 sm:text-lg",
                align === "center" && "mx-auto",
            ]}>
                {subtitle}
            </p>
        )}
        {Astro.slots.has("default") && <div class="mt-4"><slot /></div>}
    </div>
</header>
