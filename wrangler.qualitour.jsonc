{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qualitour",
  "account_id": "ca4d347f96116e87e8f5dbd6c62f0b30",
  "main": "./cms/src/emdash-free-worker.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "CMS_RUNTIME",
        "class_name": "QualitourCmsRuntime"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-qualitour-cms-runtime",
      "new_sqlite_classes": [
        "QualitourCmsRuntime"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qualitour-cms-free-test",
      "database_id": "cf36703e-a507-4810-b865-9cd57f6681a8"
    },
    {
      "binding": "TRANSFER_DB",
      "database_name": "qualitour-transfer-staging",
      "database_id": "f8cb062c-16b1-4f44-992f-8563b71ced20"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "qualitour-cms-free-test-media"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "71990ee89fd4417a9046aacbbdb88fa4"
    }
  ],
  "vars": {
    "EMDASH_SITE_URL": "https://qualitour.qualitour.workers.dev",
    "EMDASH_CMS_EXECUTION": "durable"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".astro/worker-release/assets",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": [
      "/_emdash",
      "/_emdash/*",
      "/cms-proof/*",
      "/zh/cms-proof/*",
      "/_image",
      "/api/transfer",
      "/api/transfer/*",
      "/book/*",
      "/zh/book/*"
    ]
  }
}
