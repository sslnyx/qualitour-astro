{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qualitour",
  "account_id": "ca4d347f96116e87e8f5dbd6c62f0b30",
  "main": "./cms/src/emdash-free-worker.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_ctx_exports"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "CMS_RUNTIME",
        "class_name": "QualitourCmsRuntime"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-qualitour-cms-runtime",
      "new_sqlite_classes": [
        "QualitourCmsRuntime"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qualitour-cms-free-test",
      "database_id": "cf36703e-a507-4810-b865-9cd57f6681a8"
    },
    {
      "binding": "TRANSFER_DB",
      "database_name": "qualitour-transfer-staging",
      "database_id": "f8cb062c-16b1-4f44-992f-8563b71ced20"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "qualitour-cms-free-test-media"
    },
    {
      "binding": "TRANSFER_CATALOGUE",
      "bucket_name": "qualitour-transfer-catalogue-staging"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "71990ee89fd4417a9046aacbbdb88fa4"
    }
  ],
  "vars": {
    "EMDASH_SITE_URL": "https://qualitour.qualitour.workers.dev",
    "EMDASH_CMS_EXECUTION": "durable"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.25
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".astro/worker-release/assets",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": [
      "/_emdash",
      "/_emdash/*",
      "/cms-proof/*",
      "/zh/cms-proof/*",
      "/_image",
      "/api/transfer",
      "/api/transfer/*",
      "/book/*",
      "/zh/book/*",
      "/native-proof/*",
      "/book",
      "/zh/book",
      "/404",
      "/500",
      "/",
      "/about-us",
      "/about-us/",
      "/about-us.html",
      "/contact",
      "/contact/",
      "/contact.html",
      "/faq",
      "/faq/",
      "/faq.html",
      "/privacy-policy",
      "/privacy-policy/",
      "/privacy-policy.html",
      "/terms",
      "/terms/",
      "/terms.html",
      "/visa",
      "/visa/",
      "/visa.html",
      "/reviews",
      "/reviews/",
      "/reviews.html",
      "/private-transfers",
      "/private-transfers/",
      "/private-transfers.html",
      "/tours",
      "/tours/*",
      "/tours.html",
      "/destinations/*",
      "/zh",
      "/zh/",
      "/zh/about-us",
      "/zh/about-us/",
      "/zh/about-us.html",
      "/zh/contact",
      "/zh/contact/",
      "/zh/contact.html",
      "/zh/faq",
      "/zh/faq/",
      "/zh/faq.html",
      "/zh/privacy-policy",
      "/zh/privacy-policy/",
      "/zh/privacy-policy.html",
      "/zh/terms",
      "/zh/terms/",
      "/zh/terms.html",
      "/zh/visa",
      "/zh/visa/",
      "/zh/visa.html",
      "/zh/reviews",
      "/zh/reviews/",
      "/zh/reviews.html",
      "/zh/private-transfers",
      "/zh/private-transfers/",
      "/zh/private-transfers.html",
      "/zh/tours",
      "/zh/tours/*",
      "/zh/tours.html",
      "/zh/destinations/*"
    ]
  },
  "cache": {
    "enabled": false
  },
  "exports": {
    "default": {
      "type": "worker",
      "cache": {
        "enabled": false
      }
    },
    "NativeProofCache": {
      "type": "worker",
      "cache": {
        "enabled": true
      }
    },
    "VehicleReleaseActions": {
      "type": "worker"
    }
  },
  "images": {
    "binding": "IMAGES"
  }
}
